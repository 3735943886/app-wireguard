#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: WireGuard
# Creates the interface configuration
# ==============================================================================
declare -a list
declare addresses
declare allowed_ips
declare config
declare client_dns
declare config_dir
declare dns
declare endpoint
declare filename
declare fwmark
declare host
declare interface
declare keep_alive
declare lan_ip
declare line
declare mtu
declare name
declare peer_private_key
declare peer_public_key
declare port
declare post_down
declare post_up
declare pre_down
declare pre_shared_key
declare pre_up
declare protocol
declare redirect
declare -a redirect_info
declare -a redirect_down
declare -a redirect_up
declare redirect_port
declare rule
declare server_private_key
declare server_public_key
declare table
declare -a web_peers
declare www
declare to_host
declare to_port

if ! bashio::fs.directory_exists '/ssl/wireguard'; then
    mkdir -p /ssl/wireguard ||
        bashio::exit.nok "Could not create wireguard storage folder!"
fi

# Get interface and config file location
interface="wg0"
if bashio::config.has_value "server.interface"; then
    interface=$(bashio::config "server.interface")
fi
config="/etc/wireguard/${interface}.conf"

# Detect the LAN IPv4 address of the Home Assistant host
lan_ip=""
if lan_ip=$(bashio::network.ipv4_address 2> /dev/null); then
    lan_ip=$(head -n 1 <<< "${lan_ip}")
    lan_ip="${lan_ip%%/*}"
else
    lan_ip=""
fi

# Determine the host clients use to connect, default to the LAN address
if bashio::config.has_value 'server.host'; then
    host=$(bashio::config 'server.host')
elif bashio::var.has_value "${lan_ip}"; then
    host="${lan_ip}"
    bashio::log.info "No server host configured, using LAN address ${host}"
else
    bashio::exit.nok \
        "Could not detect the LAN address of this host, please set server.host"
fi

# Start creation of configuration
echo "[Interface]" > "${config}"

# Check if at least 1 address is specified
if ! bashio::config.has_value 'server.addresses'; then
    bashio::exit.nok 'You need at least 1 address configured for the server'
fi

# Add all server addresses to the configuration
for address in $(bashio::config 'server.addresses'); do
    [[ "${address}" == *"/"* ]] || address="${address}/24"
    echo "Address = ${address}" >> "${config}"
done

# Add all server DNS addresses to the configuration
if bashio::config.has_value 'server.dns'; then
    for dns in $(bashio::config 'server.dns'); do
        echo "DNS = ${dns}" >> "${config}"
    done
else
    dns=$(bashio::dns.host)
    echo "DNS = ${dns}" >> "${config}"
fi

# Get the server's private key
if bashio::config.has_value 'server.private_key'; then
    server_private_key=$(bashio::config 'server.private_key')
else
    if ! bashio::fs.file_exists '/ssl/wireguard/private_key'; then
        umask 077 || bashio::exit.nok "Could not set a proper umask"
        wg genkey > /ssl/wireguard/private_key ||
            bashio::exit.nok "Could not generate private key!"
    fi
    server_private_key=$(</ssl/wireguard/private_key)
fi

# Get the server pubic key
if bashio::config.has_value 'server.public_key'; then
    server_public_key=$(bashio::config 'server.public_key')
else
    server_public_key=$(wg pubkey <<< "${server_private_key}")
fi

fwmark=$(bashio::config "server.fwmark")
mtu=$(bashio::config "server.mtu")
pre_down=$(bashio::config "server.pre_down")
pre_up=$(bashio::config "server.pre_up")
table=$(bashio::config "server.table")

# Pre Up & Down handling
if [[ "${pre_up}" = "off" ]]; then
    pre_up=""
fi
if [[ "${pre_down}" = "off" ]]; then
    pre_down=""
fi

# Post Up & Down defaults
post_up="iptables -A FORWARD -i %i -j ACCEPT; iptables -A FORWARD -o %i -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE"
post_down="iptables -D FORWARD -i %i -j ACCEPT; iptables -D FORWARD -o %i -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE"
if [[ $(</proc/sys/net/ipv4/ip_forward) -eq 0 ]]; then
    bashio::log.warning
    bashio::log.warning "IP forwarding is disabled on the host system!"
    bashio::log.warning "You can still use WireGuard to access Hass.io,"
    bashio::log.warning "however, you cannot access your home network or"
    bashio::log.warning "the internet via the VPN tunnel."
    bashio::log.warning
    bashio::log.warning "Please consult the app documentation on how"
    bashio::log.warning "to resolve this."
    bashio::log.warning

    # Set fake placeholders for Up & Down commands
    post_up=""
    post_down=""
fi

# Load custom PostUp setting if provided
if bashio::config.has_value 'server.post_up'; then
    post_up=$(bashio::config 'server.post_up')
    if [[ "${post_up}" = "off" ]]; then
        post_up=""
    fi
fi

# Load custom PostDown setting if provided
if bashio::config.has_value 'server.post_down'; then
    post_down=$(bashio::config 'server.post_down')
    if [[ "${post_down}" = "off" ]]; then
        post_down=""
    fi
fi

# Redirect (DNAT) traffic coming in through the tunnel
redirect_up=()
redirect_down=()
redirect_info=()
if bashio::config.has_value 'redirects'; then
    for redirect in $(bashio::config 'redirects|keys'); do
        redirect_port=$(bashio::config "redirects[${redirect}].port")

        protocol="tcp"
        if bashio::config.has_value "redirects[${redirect}].protocol"; then
            protocol=$(bashio::config "redirects[${redirect}].protocol")
        fi

        to_host="${lan_ip}"
        if bashio::config.has_value "redirects[${redirect}].to_host"; then
            to_host=$(bashio::config "redirects[${redirect}].to_host")
        fi
        if ! bashio::var.has_value "${to_host}"; then
            bashio::exit.nok \
                "Could not detect the LAN address for redirect of port ${redirect_port}, please set to_host"
        fi

        to_port="${redirect_port}"
        if bashio::config.has_value "redirects[${redirect}].to_port"; then
            to_port=$(bashio::config "redirects[${redirect}].to_port")
        fi

        rule="PREROUTING -i %i -p ${protocol} --dport ${redirect_port}"
        rule+=" -j DNAT --to-destination ${to_host}:${to_port}"
        redirect_up+=("iptables -t nat -A ${rule}")
        redirect_down+=("iptables -t nat -D ${rule}")
        redirect_info+=("${protocol}/${redirect_port} → ${to_host}:${to_port}")

        bashio::log.info \
            "Redirecting ${protocol}/${redirect_port} from the tunnel to ${to_host}:${to_port}"
    done

    if [[ $(</proc/sys/net/ipv4/ip_forward) -eq 0 ]]; then
        bashio::log.warning "Redirects require IP forwarding, which is disabled!"
    fi
fi

# Finish up the main server configuration
{
    echo "PrivateKey = ${server_private_key}"

    # Adds server port to the configuration
    echo "ListenPort = 51820"

    # Custom routing table
    bashio::config.has_value "server.table" && echo "Table = ${table}"

    # Pre up & down
    bashio::config.has_value "server.pre_up" && echo "PreUp = ${pre_up}"
    bashio::config.has_value "server.pre_down" && echo "PreDown = ${pre_down}"

    # Post up & down
    bashio::var.has_value "${post_up}" && echo "PostUp = ${post_up}"
    bashio::var.has_value "${post_down}" && echo "PostDown = ${post_down}"

    # Redirects
    for rule in "${redirect_up[@]}"; do
        echo "PostUp = ${rule}"
    done
    for rule in "${redirect_down[@]}"; do
        echo "PostDown = ${rule}"
    done

    # fwmark for outgoing packages
    bashio::config.has_value "server.fwmark" && echo "FwMark = ${fwmark}"

    # Custom MTU setting
    bashio::config.has_value "server.mtu" && echo "MTU = ${mtu}"

    # End configuration file with an empty line
    echo ""
} >> "${config}"

# Get DNS for client configurations
if bashio::config.has_value 'server.dns'; then
    dns=$(bashio::config "server.dns | join(\", \")")
fi

# Status API Storage
if ! bashio::fs.directory_exists '/var/lib/wireguard'; then
    mkdir -p /var/lib/wireguard \
        || bashio::exit.nok "Could not create status API storage folder"
fi

# Fetch all the peers
for peer in $(bashio::config 'peers|keys'); do

    name=$(bashio::config "peers[${peer}].name")

    # Check if at least 1 address is specified
    if ! bashio::config.has_value "peers[${peer}].addresses"; then
        bashio::exit.nok "You need at least 1 address configured for ${name}"
    fi

    config_dir="/ssl/wireguard/${name}"
    endpoint=$(bashio::config "peers[${peer}].endpoint")
    fwmark=$(bashio::config "peers[${peer}].fwmark")
    port=$(bashio::app.port "51820/udp")
    pre_shared_key=$(bashio::config "peers[${peer}].pre_shared_key")

    # Create directory for storing client configuration
    mkdir -p "${config_dir}" ||
        bashio::exit.nok "Failed creating client folder for ${name}"

    # Get the private key
    peer_private_key=""
    if bashio::config.has_value "peers[${peer}].private_key"; then
        peer_private_key=$(bashio::config "peers[${peer}].private_key")
    elif ! bashio::config.has_value "peers[${peer}].public_key"; then
        # If a public key is not provided, try get a private key from disk
        # or generate one if needed.
        if ! bashio::fs.file_exists "${config_dir}/private_key"; then
            umask 077 || bashio::exit.nok "Could not set a proper umask"
            wg genkey > "${config_dir}/private_key" ||
                bashio::exit.nok "Could not generate private key for ${name}!"
        fi
        peer_private_key=$(<"${config_dir}/private_key")
    fi

    # Get the public key
    peer_public_key=""
    if bashio::config.has_value "peers[${peer}].public_key"; then
        peer_public_key=$(bashio::config "peers[${peer}].public_key")
    elif bashio::var.has_value "${peer_private_key}"; then
        peer_public_key=$(wg pubkey <<< "${peer_private_key}")
    fi

    # Get peer addresses
    list=()
    for address in $(bashio::config "peers[${peer}].addresses"); do
        [[ "${address}" == *"/"* ]] || address="${address}/24"
        list+=("${address}")
    done
    addresses=$(IFS=", "; echo "${list[*]}")

    # Determine allowed IPs for server side config, by default use
    # peer defined addresses.
    list=()
    if bashio::config.has_value "peers[${peer}].allowed_ips"; then
        # Use allowed IP's defined by the user.
        for address in $(bashio::config "peers[${peer}].allowed_ips"); do
            [[ "${address}" == *"/"* ]] || address="${address}/32"
            list+=("${address}")
        done
    else
        for address in $(bashio::config "peers[${peer}].addresses"); do
            [[ "${address}" == *"/"* ]] || address="${address}/32"
            list+=("${address}")
        done
    fi
    allowed_ips=$(IFS=", "; echo "${list[*]}")

    # Determine persistent keep alive
    keep_alive=25
    if bashio::config.has_value "peers[${peer}].persistent_keep_alive"; then
        keep_alive=$(bashio::config "peers[${peer}].persistent_keep_alive")
    fi

    # Start writing peer information in server config
    {
        echo "[Peer]"
        echo "PublicKey = ${peer_public_key}"
        echo "AllowedIPs = ${allowed_ips}"
        echo "PersistentKeepalive = ${keep_alive}"
        bashio::config.has_value "peers[${peer}].pre_shared_key" \
            && echo "PreSharedKey = ${pre_shared_key}"
        bashio::config.has_value "peers[${peer}].endpoint" \
            && echo "Endpoint = ${endpoint}"
        echo ""
    } >> "${config}"

    # Generate client configuration

    # Determine allowed IPs for client configuration
    allowed_ips="0.0.0.0/0"
    if bashio::config.has_value "peers[${peer}].client_allowed_ips"; then
        allowed_ips=$(
            bashio::config "peers[${peer}].client_allowed_ips | join(\", \")"
        )
    fi

    # Determine DNS for client configuration, "off" leaves it out
    client_dns="${dns}"
    if bashio::config.has_value "peers[${peer}].client_dns"; then
        client_dns=$(bashio::config "peers[${peer}].client_dns")
        if [[ "${client_dns}" = "off" ]]; then
            client_dns=""
        fi
    fi

    # Write client configuration file
    {
        echo "[Interface]"
        bashio::var.has_value "${peer_private_key}" \
            && echo "PrivateKey = ${peer_private_key}"
        echo "Address = ${addresses}"
        bashio::var.has_value "${client_dns}" && echo "DNS = ${client_dns}"
        bashio::config.has_value "peers[${peer}].fwmark" \
            && echo "FwMark = ${fwmark}"
        echo ""
        echo "[Peer]"
        echo "PublicKey = ${server_public_key}"
        echo "Endpoint = ${host}:${port}"
        echo "AllowedIPs = ${allowed_ips}"
        echo "PersistentKeepalive = ${keep_alive}"
        bashio::config.has_value "peers[${peer}].pre_shared_key" \
            && echo "PresharedKey = ${pre_shared_key}"
        echo ""
    } > "${config_dir}/client.conf"

    # Optionally show the client configuration in the log
    if bashio::config.true 'log_client_config'; then
        bashio::log.info "Client configuration for ${name}:"
        while IFS= read -r line; do
            bashio::log.info "    ${line}"
        done < "${config_dir}/client.conf"
    fi

    # Generate QR code with client configuration
    qrencode -t PNG -o "${config_dir}/qrcode.png" < "${config_dir}/client.conf"

    # Store client name for the status API based on public key
    filename=$(sha1sum <<< "${peer_public_key}" | awk '{ print $1 }')
    echo -n "${name}" > "/var/lib/wireguard/${filename}"

    web_peers+=("${name}")
done

# Build the ingress page with the client configurations
www="/var/www/wireguard"
rm -f -r "${www}"
mkdir -p "${www}" || bashio::exit.nok "Could not create ingress web folder"

function html() {
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

{
    cat << 'HTML'
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WireGuard</title>
<style>
:root {
  --bg: #fafafa; --card: #ffffff; --text: #212121; --muted: #616161;
  --border: #e0e0e0; --accent: #03a9f4; --accent-text: #ffffff;
  --code: #f5f5f5; --warn-bg: #fff8e1; --warn-border: #ffb300;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #111111; --card: #1c1c1c; --text: #e1e1e1; --muted: #9e9e9e;
    --border: #333333; --accent: #03a9f4; --accent-text: #ffffff;
    --code: #262626; --warn-bg: #2d2610; --warn-border: #ffb300;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 16px; background: var(--bg); color: var(--text);
  font: 14px/1.5 -apple-system, "Segoe UI", Roboto, "Noto Sans KR", sans-serif;
}
main { max-width: 760px; margin: 0 auto; }
h1 { font-size: 22px; margin: 8px 0 16px; }
h2 { font-size: 16px; margin: 0 0 12px; }
section {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 12px; padding: 16px; margin-bottom: 16px;
}
dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0; }
dt { color: var(--muted); }
dd { margin: 0; overflow-wrap: anywhere; font-family: ui-monospace, monospace; }
.button {
  display: inline-block; background: var(--accent); color: var(--accent-text);
  text-decoration: none; padding: 8px 14px; border-radius: 8px; font-weight: 600;
  margin: 12px 0 4px;
}
details { margin-top: 8px; }
summary { cursor: pointer; color: var(--muted); }
pre {
  background: var(--code); padding: 12px; border-radius: 8px;
  overflow-x: auto; font-size: 12px; margin: 8px 0 0;
}
img.qr { width: 220px; max-width: 100%; background: #ffffff; padding: 8px; border-radius: 8px; margin-top: 8px; }
ol { padding-left: 20px; margin: 0; }
li { margin-bottom: 6px; }
.warn {
  background: var(--warn-bg); border-left: 4px solid var(--warn-border);
  padding: 8px 12px; border-radius: 4px; margin: 8px 0;
}
code { font-family: ui-monospace, monospace; }
</style>
</head>
<body>
<main>
<h1>WireGuard</h1>
HTML

    echo "<section><h2>서버</h2><dl>"
    echo "<dt>Endpoint</dt><dd>$(html <<< "${host}:${port:-51820}")</dd>"
    echo "<dt>공개키</dt><dd>$(html <<< "${server_public_key}")</dd>"
    for rule in "${redirect_info[@]}"; do
        echo "<dt>리다이렉트</dt><dd>$(html <<< "${rule}")</dd>"
    done
    echo "</dl></section>"

    for name in "${web_peers[@]}"; do
        cp "/ssl/wireguard/${name}/client.conf" "${www}/${name}.conf"
        cp "/ssl/wireguard/${name}/qrcode.png" "${www}/${name}.png"
        echo "<section><h2>$(html <<< "${name}")</h2>"
        echo "<a class=\"button\" href=\"${name}.conf\" download=\"${name}.conf\">${name}.conf 다운로드</a>"
        echo "<details><summary>설정 내용 보기</summary><pre>"
        html < "${www}/${name}.conf"
        echo "</pre></details>"
        echo "<details><summary>QR 코드</summary>"
        echo "<img class=\"qr\" src=\"${name}.png\" alt=\"${name} QR\"></details>"
        echo "</section>"
    done

    cat << 'HTML'
<section>
<h2>ipTIME 공유기에 등록하기</h2>
<ol>
<li>공유기 관리 화면에서 <b>관리도구 › VPN 설정 › WireGuard 클라이언트</b>로 이동해 <b>추가(+)</b>를 누릅니다.</li>
<li><b>[설정 가져오기]</b>를 눌러 위에서 받은 <code>.conf</code> 파일을 올립니다.</li>
<li>이름을 입력하고 클라이언트는 <b>실행</b>으로 선택합니다.
<div class="warn"><b>[모든 트래픽이 이 VPN을 경유하도록 규칙 생성]</b>은 반드시 <b>체크하지 마세요.</b> 체크하면 모든 단말의 트래픽이 Home Assistant를 거치게 됩니다.</div></li>
<li><b>VPN 설정 › 클라이언트 사용 관리</b>에서 <b>추가(+)</b>를 누르고, VPN은 방금 등록한 항목, 단말은 리다이렉트할 기기(예: LG 가전), 목적지는 <b>모든 목적지</b>, 네트워크 Lock은 <b>끄기</b>로 설정합니다.</li>
<li>해당 기기를 재부팅하거나 Wi-Fi 연결을 끊었다 다시 연결해 새 경로로 접속하게 합니다.</li>
</ol>
</section>
</main>
</body>
</html>
HTML
} > "${www}/index.html"
